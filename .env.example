# --- Base de datos (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgres://triff:triff@localhost:5432/triff
TEST_DATABASE_URL=postgres://triff:triff@localhost:5432/triff_test

# --- Autenticación (Better Auth) ---
BETTER_AUTH_SECRET=cambia-esto-por-32+-caracteres-aleatorios
BETTER_AUTH_URL=http://localhost:3000

# --- IA: sin clave la app funciona en "modo sin IA" (extracción literal + RAG) ---
AI_PROVIDER=anthropic            # anthropic | openai | google
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_MODEL_TUTOR=claude-opus-5-5
# AI_MODEL_GENERATION=claude-opus-5-5

# --- Embeddings (opcional; sin ellos la búsqueda usa solo texto completo) ---
EMBEDDINGS_PROVIDER=none         # none | openai | google
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- Límites ---
AI_DAILY_LIMIT_FREE=40
